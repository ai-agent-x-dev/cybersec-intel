# ============================================================
# cybersec-intel - API keys
# ============================================================
# Copy this file to .env (chmod 600) and fill in the keys you have.
# Every key is optional: a missing key only disables that source.
# All of these services have a free tier.
#
# Where to get them:
#   VirusTotal     : https://www.virustotal.com/gui/my-apikey
#   AbuseIPDB      : https://www.abuseipdb.com/account/api
#   AlienVault OTX : https://otx.alienvault.com/api
#   NVD            : https://nvd.nist.gov/developers/request-an-api-key
#   Shodan         : https://account.shodan.io/
#   abuse.ch       : https://auth.abuse.ch/
#   MyThreatIntel  : https://mythreatintel.secureit.es
# ============================================================

# VirusTotal - IP/domain/URL/file reputation, deep mode
VT_API_KEY=

# AbuseIPDB - IP abuse score, /24 block check, blacklist feed
ABUSEIPDB_API_KEY=

# AlienVault OTX - pulses, passive DNS, CVE exploit intel
OTX_API_KEY=

# NVD - CVE detail and feeds (optional, raises the rate limit)
NVD_API_KEY=

# Shodan - host lookup (services, versions, TLS)
SHODAN_API_KEY=

# abuse.ch - one key for URLhaus, ThreatFox and MalwareBazaar
URLHAUS_AUTH_KEY=

# MyThreatIntel (optional)
MYTHREATINTEL_TOKEN=
